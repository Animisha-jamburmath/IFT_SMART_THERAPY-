__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Database files
*.db
*.sqlite
*.sqlite3

# ═══════════════════════════════════════════════
# NODE / FRONTEND
# ═══════════════════════════════════════════════
node_modules/
dist/
build/
.vite/
*.local

# ═══════════════════════════════════════════════
# ENVIRONMENT VARIABLES (CRITICAL - NEVER PUSH!)
# ═══════════════════════════════════════════════
.env
.env.local
.env.production
*.env

# ═══════════════════════════════════════════════
# IDE / OS
